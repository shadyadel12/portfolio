# Copy to .env to override defaults (optional).

# Port the server listens on
PORT=3000

# The /admin editing dashboard is a LOCAL tool and is NOT part of the live site.
# It is ON by default for local use and automatically OFF when NODE_ENV=production.
# You normally don't need to set this — deploy with NODE_ENV=production and admin stays off.
# Force it explicitly if you want: ADMIN_ENABLED=true  (or false)
# ADMIN_ENABLED=true

# ---- Hack The Box live sync -------------------------------------------------
# Create a personal App Token at: HTB → Profile → App Tokens → Create.
# Paste it here (this file is git-ignored). The HTB section appears only when set.
# HTB_TOKEN=your-htb-app-token
# Optional: your numeric HTB user id (auto-detected from the token if omitted).
# HTB_USER_ID=123456
# Hide the Labs section without removing the token: set to false.
# HTB_ENABLED=true
# Optional overrides:
# HTB_API_BASE=https://labs.hackthebox.com/api/v4
# HTB_CACHE_MINUTES=15
